# ============================================================
# ai_bento インスタンス 認証情報テンプレート
# このファイルを .env にコピーして値を埋めてください
# ============================================================

# ── VPS接続情報（WordPressセットアップ用）──
VPS_HOST=xxx.xxx.xxx.xxx
VPS_ROOT_PASSWORD=your_vps_root_password

# ── WordPress（セットアップ後に設定）──
WP_SITE_URL=https://ai-bento.com
WP_USERNAME=
WP_APP_PASSWORD=

# ── X (Twitter) API（アカウント作成後に設定）──
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_EMAIL=
X_PASSWORD=

# ── A8.net アフィリエイトリンク（提携承認後に設定）──
AFFILIATE_WINSCHOOL_URL=
AFFILIATE_XSERVER_URL=
AFFILIATE_CONOHA_AI_URL=

# ── 通知 ──
DISCORD_WEBHOOK_URL=

# ── Claude API ──
USE_CLAUDE_CLI=1
